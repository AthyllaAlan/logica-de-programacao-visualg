Algoritmo "exercicio-06-area-retangulo"
// Disciplina   : [Lógica de Programação]
// Professor    : Jaison Costa Dos Santos
// Descrição    : Lê a base e a altura de um retângulo e calcula sua área.
// Autor(a)     : Athylla Alan Dos Santos Oliveira
// Data atual   : 30/09/2026
Var
// Seção de Declarações das variáveis 
base, altura, area : real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreval("Digite o valor da base do retângulo:")
leia(base)

escreval("Digite o valor da altura do retângulo:")
leia(altura)

area <- base * altura

escreval("A área do retângulo é: ", area)

Fimalgoritmo